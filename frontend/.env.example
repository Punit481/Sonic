# Clerk publishable key (safe to expose; it's meant for the browser)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Sonic API (the Spring Boot backend)
VITE_BACKEND_URL=http://localhost:8080

# Never put secret keys in VITE_* variables: Vite bundles them into the
# public JavaScript. The Clerk secret key belongs only on the backend.
