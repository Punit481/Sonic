# Copy to .env (never commit it) or set these in your host's environment.

# Postgres. Locally, compose.yaml starts one and these defaults match it.
DATABASE_URL=jdbc:postgresql://localhost:5432/sonic
DATABASE_USERNAME=sonic
DATABASE_PASSWORD=sonic

# Clerk Frontend API URL (Clerk dashboard → API keys → "Frontend API URL")
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional. Only needed if the session token isn't customised to include email (see README).
CLERK_SECRET_KEY=

# Groq API key (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: other Groq models
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Comma-separated frontend origins allowed to call the API
SONIC_ALLOWED_ORIGINS=http://localhost:5173

# Optional
# PORT=8080
# SONIC_AI_REQUESTS_PER_HOUR=30
# LOG_FORMAT=ecs        # JSON logs in production
